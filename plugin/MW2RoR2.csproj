<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>MW2RoR2</AssemblyName>
    <RootNamespace>MW2RoR2</RootNamespace>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <RoR2Managed>C:\Program Files (x86)\Steam\steamapps\common\Risk of Rain 2\Risk of Rain 2_Data\Managed</RoR2Managed>
    <BepInExCore>$(MSBuildThisFileDirectory)..\deps\bepinexpack\BepInEx\core</BepInExCore>
  </PropertyGroup>
  <!-- Compile against the user's own game and loader DLLs; nothing is copied or shipped. -->
  <ItemGroup>
    <Reference Include="BepInEx"><HintPath>$(BepInExCore)\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(BepInExCore)\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="RoR2"><HintPath>$(RoR2Managed)\RoR2.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="LegacyResourcesAPI"><HintPath>$(RoR2Managed)\LegacyResourcesAPI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="HGCSharpUtils"><HintPath>$(RoR2Managed)\HGCSharpUtils.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.TextMeshPro"><HintPath>$(RoR2Managed)\Unity.TextMeshPro.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AK.Wwise.Unity.API"><HintPath>$(RoR2Managed)\AK.Wwise.Unity.API.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="KinematicCharacterController"><HintPath>$(RoR2Managed)\KinematicCharacterController.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Rewired_Core"><HintPath>$(RoR2Managed)\Rewired_Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="com.unity.multiplayer-hlapi.Runtime"><HintPath>$(RoR2Managed)\com.unity.multiplayer-hlapi.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(RoR2Managed)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(RoR2Managed)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(RoR2Managed)\UnityEngine.UIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ParticleSystemModule"><HintPath>$(RoR2Managed)\UnityEngine.ParticleSystemModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ImageConversionModule"><HintPath>$(RoR2Managed)\UnityEngine.ImageConversionModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ScreenCaptureModule"><HintPath>$(RoR2Managed)\UnityEngine.ScreenCaptureModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AudioModule"><HintPath>$(RoR2Managed)\UnityEngine.AudioModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="HGUnityUtils"><HintPath>$(RoR2Managed)\HGUnityUtils.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(RoR2Managed)\UnityEngine.PhysicsModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(RoR2Managed)\UnityEngine.InputLegacyModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(RoR2Managed)\UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(RoR2Managed)\UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(RoR2Managed)\UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.Postprocessing.Runtime"><HintPath>$(RoR2Managed)\Unity.Postprocessing.Runtime.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <!-- Thunderstore asks AI-assisted mods to say so in the assembly too (wiki: LLMs and AI generated files). -->
  <ItemGroup>
    <AssemblyMetadata Include="AI_Assisted_Creation" Value="Designed, directed and playtested by buhhrad; code written with an AI coding agent" />
    <AssemblyMetadata Include="AI_Model_Vendor" Value="Anthropic (Claude, via Claude Code)" />
  </ItemGroup>
</Project>
